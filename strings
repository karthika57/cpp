int main()  
{ 
    int n; 
    cin>>n; 
    string s; 
    cin>>s; 
    int balance=0,count=0; 
    for (int i=0;i<=s.size()-1;i++) 
    { 
      if (s[i]=='A') 
        balance++; 
      else if (s[i]=='B') 
        balance--; 
      if (balance==0) 
        count++; 
    } 
