#include <iostream> 
#include <sstream> 
using namespace std; 
int main() 
{ 
string v1,v2; 
cin>>v1>>v2; 
int a1,b1,c1; 
int a2,b2,c2; 
    char dot; 
 
    stringstream s1(v1); 
    s1>>a1>>dot>>b1>>dot>>c1; 
 
    stringstream s2(v2); 
    s2>>a2>>dot>>b2>>dot>>c2; 
 
    if(a2>a1) 
        cout<<"upgraded"; 
    else if(a2<a1) 
        cout<<"downgraded"; 
    else if(b2>b1) 
