   for(int i=0;i<n;i++)
   {
       cin>>a[i];
   }
   int target;
   cin>>target;

   //1 element subset
   for(int i=0;i<n;i++)
   {
       if (a[i]==target)
          cout<<"{"<<a[i]<<"}"<<endl;
   }

   //2 element subset
   for(int i=0;i<n;i++)
   {
       for (int j=i+1;j<n;j++)
       {
          if (a[i]+a[j]==target)
