 Input:
 5
 1 2 3 4 5
 Output:
 Even: 2 Odd: 3
 
#include <iostream>
using namespace std;

int odd(int n,int a[])
{
  int count=0;
  for (int i=0;i<n;i++)
  {
    if (i%2==0)
       count++;
  }
  return count;
}

int even(int n,int a[])
{
  int count=0;
  for (int i=0;i<n;i++)
  {
    if (i%2!=0)
       count++;
  }
  return count;
}

int add(int n,int a[])
{
  int sum=0;
  for (int i=0;i<n;i++)
  { 
    sum+=a[i];
  }
  return sum;
}

int main()
{
  int n;
  cin>>n;
  int a[n];
  for (int i=0;i<n;i++)
     cin>>a[i];
  cout<<"odd: "<<odd(n,a)<<" ";
  cout<<"even: "<<even(n,a);
}
